// ─── Digital Swatches Component ────────────────────────────────────────────────
export function DigitalSwatches({ products, onClose }: DigitalSwatchesProps) {
  const [search, setSearch] = useState("");
  const [selectedColor, setSelectedColor] = useState<string | null>(null);
  const [copied, setCopied] = useState<string | null>(null);

  const allColors = useMemo(() => {
    const colorMap = new Map<string, { hex: string; products: string[] }>();

    products.forEach((product) => {
      product.colors.forEach((color) => {
        if (!colorMap.has(color)) {
          colorMap.set(color, { hex: color, products: [] });
        }
        const entry = colorMap.get(color)!;
        if (!entry.products.includes(product.name)) {
          entry.products.push(product.name);
        }
      });
    });

    return Array.from(colorMap.values());
  }, [products]);

  const filteredColors = useMemo(() => {
    if (!search) return allColors;
    return allColors.filter(
      (c) =>
        c.hex.toLowerCase().includes(search.toLowerCase()) ||
        c.products.some((p) => p.includes(search))
    );
  }, [allColors, search]);

  const copyToClipboard = (hex: string) => {
    navigator.clipboard.writeText(hex);
    setCopied(hex);
    setTimeout(() => setCopied(null), 2000);
  };

  return (
    <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto shadow-2xl">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <Search size={20} className="text-purple-600" />
            </div>
            <h2 className="text-2xl font-black text-foreground">الكتالوج الرقمي للألوان</h2>
          </div>
          <button onClick={onClose} className="p-1.5 hover:bg-secondary rounded-lg">
            <X size={20} />
          </button>
        </div>

        <div className="mb-6">
          <div className="relative">
            <Search className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="ابحث عن لون أو منتج..."
              className="w-full border border-border rounded-lg px-4 py-3 pl-10 text-sm bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
        </div>

        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-6">
          {filteredColors.map((colorEntry) => (
            <div
              key={colorEntry.hex}
              className="cursor-pointer group"
              onClick={() =>
                setSelectedColor(selectedColor === colorEntry.hex ? null : colorEntry.hex)
              }
            >
              <div
                className="w-full aspect-square rounded-xl border-2 border-border shadow-md transition-all group-hover:shadow-lg group-hover:border-primary mb-2"
                style={{ backgroundColor: colorEntry.hex }}
              />
              <div className="text-xs font-mono text-foreground group-hover:text-primary transition-colors">
                {colorEntry.hex}
              </div>
              <div className="text-[10px] text-muted-foreground mt-1">
                {colorEntry.products.length} منتج
              </div>

              {selectedColor === colorEntry.hex && (
                <div className="mt-3 p-3 bg-secondary rounded-lg border border-border">
                  <div className="text-xs font-semibold text-foreground mb-2">المنتجات:</div>
                  <div className="space-y-1">
                    {colorEntry.products.map((product) => (
                      <div key={product} className="text-xs text-muted-foreground">
                        • {product}
                      </div>
                    ))}
                  </div>
                  <button
                    onClick={(e) => {
                      e.stopPropagation();
                      copyToClipboard(colorEntry.hex);
                    }}
                    className="w-full mt-2 flex items-center justify-center gap-2 bg-primary/10 text-primary text-xs font-semibold py-2 rounded-lg hover:bg-primary/20 transition-colors"
                  >
                    {copied === colorEntry.hex ? (
                      <>
                        <Check size={12} />
                        تم النسخ
                      </>
                    ) : (
                      <>
                        <Copy size={12} />
                        نسخ الكود
                      </>
                    )}
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>

        {filteredColors.length === 0 && (
          <div className="text-center py-12">
            <p className="text-muted-foreground">لم يتم العثور على ألوان مطابقة</p>
          </div>
        )}

        <button
          onClick={onClose}
          className="w-full bg-primary text-primary-foreground font-bold py-3 rounded-xl hover:bg-primary/90 transition-colors"
        >
          إغلاق
        </button>
      </div>
    </div>
  );
}
