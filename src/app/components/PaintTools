import { useState, useMemo } from "react";
import { X, Calculator, Palette, Search, Copy, Check } from "lucide-react";

// ─── Types ────────────────────────────────────────────────────────────────────
interface Product {
  id: string;
  name: string;
  colors: string[];
  size: string;
  price: number;
}

interface RoomVisualizerProps {
  color: string;
  onClose: () => void;
}

interface PaintCalculatorProps {
  onClose: () => void;
}

interface DigitalSwatchesProps {
  products: Product[];
  onClose: () => void;
}

// ─── Paint Calculator Component ────────────────────────────────────────────────
export function PaintCalculator({ onClose }: PaintCalculatorProps) {
  const [length, setLength] = useState<number>(0);
  const [width, setWidth] = useState<number>(0);
  const [height, setHeight] = useState<number>(2.5);
  const [coats, setCoats] = useState<number>(2);
  const [coverage, setCoverage] = useState<number>(10); // متر مربع لكل لتر

  const wallArea = useMemo(() => {
    if (!length || !width || !height) return 0;
    // حساب مساحة الجدران: 2 × (الطول + العرض) × الارتفاع
    return 2 * (length + width) * height;
  }, [length, width, height]);

  const ceilingArea = useMemo(() => {
    if (!length || !width) return 0;
    return length * width;
  }, [length, width]);

  const totalArea = wallArea + ceilingArea;

  const literRequired = useMemo(() => {
    return Math.ceil((totalArea * coats) / coverage);
  }, [totalArea, coats, coverage]);

  const canSizeOptions = [
    { liters: 1, label: "1 لتر" },
    { liters: 4, label: "4 لتر" },
    { liters: 5, label: "5 لتر" },
    { liters: 18, label: "18 لتر" },
  ];

  const cansNeeded = useMemo(() => {
    const result: { size: string; quantity: number }[] = [];
    let remaining = literRequired;

    // ترتيب تنازلي للحصول على أقل عدد علب
    const sorted = [...canSizeOptions].sort((a, b) => b.liters - a.liters);

    for (const can of sorted) {
      if (remaining >= can.liters) {
        const quantity = Math.floor(remaining / can.liters);
        result.push({ size: can.label, quantity });
        remaining -= quantity * can.liters;
      }
    }

    // إذا كان هناك باقي، أضف علبة صغيرة
    if (remaining > 0) {
      result.push({ size: "1 لتر", quantity: 1 });
    }

    return result;
  }, [literRequired]);

  return (
    <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
              <Calculator size={20} className="text-primary" />
            </div>
            <h2 className="text-2xl font-black text-foreground">حاسبة الكمية</h2>
          </div>
          <button onClick={onClose} className="p-1.5 hover:bg-secondary rounded-lg">
            <X size={20} />
          </button>
        </div>

        <p className="text-sm text-muted-foreground mb-6">
          أدخل أبعاد الغرفة لحساب كمية الطلاء المطلوبة بدقة
        </p>

        <div className="grid grid-cols-2 gap-4 mb-6">
          <div>
            <label className="text-sm font-semibold text-foreground mb-2 block">
              الطول (متر)
            </label>
            <input
              type="number"
              value={length || ""}
              onChange={(e) => setLength(parseFloat(e.target.value) || 0)}
              placeholder="5"
              className="w-full border border-border rounded-lg px-3 py-2 text-sm bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
          <div>
            <label className="text-sm font-semibold text-foreground mb-2 block">
              العرض (متر)
            </label>
            <input
              type="number"
              value={width || ""}
              onChange={(e) => setWidth(parseFloat(e.target.value) || 0)}
              placeholder="4"
              className="w-full border border-border rounded-lg px-3 py-2 text-sm bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
          <div>
            <label className="text-sm font-semibold text-foreground mb-2 block">
              الارتفاع (متر)
            </label>
            <input
              type="number"
              value={height || ""}
              onChange={(e) => setHeight(parseFloat(e.target.value) || 0)}
              placeholder="2.5"
              className="w-full border border-border rounded-lg px-3 py-2 text-sm bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
          <div>
            <label className="text-sm font-semibold text-foreground mb-2 block">
              عدد الطبقات
            </label>
            <select
              value={coats}
              onChange={(e) => setCoats(parseInt(e.target.value))}
              className="w-full border border-border rounded-lg px-3 py-2 text-sm bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/30"
            >
              <option value={1}>طبقة واحدة</option>
              <option value={2}>طبقتان</option>
              <option value={3}>ثلاث طبقات</option>
            </select>
          </div>
        </div>

        <div className="bg-secondary rounded-xl p-4 mb-6">
          <div className="grid grid-cols-3 gap-4">
            <div>
              <div className="text-xs text-muted-foreground mb-1">مساحة الجدران</div>
              <div className="text-2xl font-black text-primary">{wallArea.toFixed(1)}</div>
              <div className="text-xs text-muted-foreground">م²</div>
            </div>
            <div>
              <div className="text-xs text-muted-foreground mb-1">مساحة السقف</div>
              <div className="text-2xl font-black text-primary">{ceilingArea.toFixed(1)}</div>
              <div className="text-xs text-muted-foreground">م²</div>
            </div>
            <div>
              <div className="text-xs text-muted-foreground mb-1">الإجمالي</div>
              <div className="text-2xl font-black text-accent">{totalArea.toFixed(1)}</div>
              <div className="text-xs text-muted-foreground">م²</div>
            </div>
          </div>
        </div>

        <div className="bg-primary/10 rounded-xl p-4 mb-6 border border-primary/20">
          <div className="flex items-baseline gap-2 mb-2">
            <span className="text-sm text-muted-foreground">الكمية المطلوبة:</span>
            <span className="text-3xl font-black text-primary">{literRequired}</span>
            <span className="text-sm text-muted-foreground">لتر</span>
          </div>
          <p className="text-xs text-muted-foreground">
            بناءً على {coats} طبقة و {coverage} متر مربع لكل لتر
          </p>
        </div>

        <div className="mb-6">
          <h3 className="font-semibold text-foreground mb-3">التوصية بالعلب:</h3>
          <div className="space-y-2">
            {cansNeeded.length > 0 ? (
              cansNeeded.map((can, idx) => (
                <div
                  key={idx}
                  className="flex items-center justify-between bg-secondary rounded-lg p-3"
                >
                  <span className="text-sm font-medium">{can.size}</span>
                  <span className="text-lg font-black text-primary">× {can.quantity}</span>
                </div>
              ))
            ) : (
              <p className="text-sm text-muted-foreground">أدخل أبعاد الغرفة لرؤية التوصيات</p>
            )}
          </div>
        </div>

        <button
          onClick={onClose}
          className="w-full bg-primary text-primary-foreground font-bold py-3 rounded-xl hover:bg-primary/90 transition-colors"
        >
          إغلاق
        </button>
      </div>
    </div>
  );
}

